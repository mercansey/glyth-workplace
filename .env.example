# Glyth Snapshot — copy to .env for the Node server. All values are placeholders.
# DEMO-ONLY: the demo runs with no credentials at all (deterministic fallback).
DEMO_MODE=true
PORT=3000

# OPTIONAL — Meta Model API (server-side only, never exposed to the browser).
# Without MODEL_API_KEY the deterministic rule engine runs alone and the demo still works.
MODEL_API_KEY=
META_MODEL=muse-spark-1.1
META_API_BASE_URL=https://api.meta.ai/v1

# OPTIONAL — Supabase: TWO dedicated HACKATHON projects (never production Glyth).
# Only needed for live auth/bridge sync; in-memory demo mode needs none of these.
# Project A — USER CONTEXT (personal data, migrations 001 + 003)
USER_SUPABASE_URL=
USER_SUPABASE_ANON_KEY=
USER_SUPABASE_SERVICE_KEY=
# Project B — SYSTEM CONTEXT (workplace/system data, migrations 002 + 004)
SYSTEM_SUPABASE_URL=
SYSTEM_SUPABASE_ANON_KEY=
SYSTEM_SUPABASE_SERVICE_KEY=
# Bridge (server-side only; service keys must never reach the browser)
BRIDGE_SALT=change-me-long-random-string
# Required outside DEMO_MODE to call POST /api/bridge/sync (x-admin-token header)
BRIDGE_ADMIN_TOKEN=
MIN_COHORT_SIZE=5
